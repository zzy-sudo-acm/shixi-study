  "components": [
    {
      "name": "主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "创建和保存动作；墨绿纸面，悬停转为操作绿。",
      "html": "<button type=\"button\" class=\"ds-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>新建领域</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 19px;border-radius:8px;font:500 15px/1.4 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;cursor:pointer;text-decoration:none;white-space:nowrap;transition:background-color .15s,border-color .15s;border:1px solid var(--ink,#263e35);background:var(--ink,#263e35);color:var(--paper,#fff);}.ds-primary:hover{background:var(--accent,#416b53);}.ds-primary:disabled{opacity:.48;cursor:not-allowed;}.ds-primary:focus-visible{outline:3px solid #688d76;outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;}}"
    },
    {
      "name": "次按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "新建目标等补充动作；白纸和清晰细边框。",
      "html": "<button type=\"button\" class=\"ds-secondary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>新建目标</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 19px;border-radius:8px;font:500 15px/1.4 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;cursor:pointer;text-decoration:none;white-space:nowrap;transition:background-color .15s,border-color .15s;border:1px solid #c5d3c9;background:var(--paper,#fff);color:var(--ink,#263e35);}.ds-secondary:hover{background:#edf3ee;border-color:#abbacb;}.ds-secondary:focus-visible{outline:3px solid #688d76;outline-offset:4px;}.ds-secondary:disabled{opacity:.48;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none;}}"
    },
    {
      "name": "文字操作",
      "kind": "button",
      "refersTo": "button-text",
      "description": "节点编辑、移动及任务关联等行内操作；手机扩大操作高度。",
      "html": "<button type=\"button\" class=\"ds-text\">编辑节点</button>",
      "css": ".ds-text{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 19px;border-radius:8px;font:500 15px/1.4 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;cursor:pointer;text-decoration:none;white-space:nowrap;transition:background-color .15s,border-color .15s;min-height:36px;padding:4px 2px;border:0;background:transparent;color:var(--accent,#416b53);font-size:12px;}.ds-text:hover{background:#edf3ee;}.ds-text:focus-visible{outline:3px solid #688d76;outline-offset:4px;}.ds-text:disabled{opacity:.48;cursor:not-allowed;}@media(max-width:640px){.ds-text{min-height:44px;}}@media(prefers-reduced-motion:reduce){.ds-text{transition:none;}}"
    },
    {
      "name": "搜索字段",
      "kind": "input",
