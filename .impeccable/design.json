      "html": "<input class=\"ds-field\" type=\"search\" aria-label=\"搜索知识节点\" placeholder=\"查找节点\"/>",
      "css": ".ds-field{width:100%;max-width:100%;min-height:44px;padding:11px 12px;border:1px solid #bbcbbf;border-radius:7px;background:var(--paper,#fff);color:var(--ink,#263e35);font:400 15px/1.65 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;caret-color:var(--accent,#416b53);}.ds-field::placeholder{color:#607267;}.ds-field:focus-visible{outline:3px solid #688d76;outline-offset:4px;}@media(max-width:640px){.ds-field{font-size:16px;}}"
    },
