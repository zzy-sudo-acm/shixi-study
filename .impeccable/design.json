  "components": [
    {
      "name": "主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "创建和保存动作；黑色药丸，悬停提亮为 #363636。",
      "html": "<button type=\"button\" class=\"ds-primary\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>新建领域</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 20px;border-radius:999px;font:500 15px/1.4 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;cursor:pointer;text-decoration:none;white-space:nowrap;transition:background-color .15s,border-color .15s;border:1px solid var(--ink,#171717);background:var(--ink,#171717);color:var(--paper,#fff);}.ds-primary:hover{background:#363636;border-color:#363636;}.ds-primary:disabled{opacity:.45;cursor:not-allowed;}.ds-primary:focus-visible{outline:3px solid #767676;outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;}}"
    },
    {
      "name": "次按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "放弃修改等补充动作；白纸和清晰细边框。",
      "html": "<button type=\"button\" class=\"ds-secondary\">放弃修改</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 19px;border-radius:999px;font:500 15px/1.4 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;cursor:pointer;text-decoration:none;white-space:nowrap;transition:background-color .15s,border-color .15s;border:1px solid #dcdcdc;background:var(--paper,#fff);color:var(--ink,#171717);}.ds-secondary:hover{background:#f1f1ef;}.ds-secondary:focus-visible{outline:3px solid #767676;outline-offset:4px;}.ds-secondary:disabled{opacity:.45;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none;}}"
    },
    {
      "name": "文字操作",
      "kind": "button",
      "refersTo": "button-text",
      "description": "节点编辑、移动及任务关联等行内操作；深灰文字，悬停转黑。",
      "html": "<button type=\"button\" class=\"ds-text\">编辑节点</button>",
      "css": ".ds-text{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:36px;padding:4px 2px;border:0;background:transparent;color:#505050;font:500 12px/1.4 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;cursor:pointer;transition:color .15s;}.ds-text:hover{color:#111;}.ds-text:focus-visible{outline:3px solid #767676;outline-offset:4px;}.ds-text:disabled{opacity:.48;cursor:not-allowed;}@media(max-width:640px){.ds-text{min-height:44px;}}@media(prefers-reduced-motion:reduce){.ds-text{transition:none;}}"
    },
    {
      "name": "搜索字段",
      "kind": "input",
      "refersTo": "field",
      "description": "关联选择器沿用白纸搜索输入；目录搜索圆角6px，名称输入5px，手机16px文字。",
      "html": "<input class=\"ds-field\" type=\"search\" aria-label=\"搜索知识节点\" placeholder=\"查找节点\"/>",
      "css": ".ds-field{width:100%;max-width:100%;min-height:44px;padding:11px 12px;border:1px solid #dcdcdc;border-radius:7px;background:var(--paper,#fff);color:var(--ink,#171717);font:400 15px/1.65 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;caret-color:#171717;}.ds-field::placeholder{color:#737373;}.ds-field:focus-visible{outline:3px solid #767676;outline-offset:4px;}@media(max-width:640px){.ds-field{font-size:16px;}}"
    },
    {
      "name": "主导航",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "顶栏居中三项药丸导航，选中为黑底白字；手机品牌在上、入口等分在下。",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航\"><a class=\"ds-nav-active\" aria-current=\"page\" href=\"#home\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 4h12a4 4 0 0 1 4 4v13H8a4 4 0 0 1-4-4V4zM8 9h8M8 13h6\"/></svg><span>学习空间</span></a><a href=\"#library\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"7\" y=\"5\" width=\"13\" height=\"16\" rx=\"2\"/><path d=\"M4 17V3a1 1 0 0 1 1-1h11M11 10h5m-5 4h3\"/></svg><span>记忆卡片</span></a><a href=\"#settings\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 7h16M4 17h16\"/><circle cx=\"8\" cy=\"7\" r=\"3\"/><circle cx=\"16\" cy=\"17\" r=\"3\"/></svg><span>设置与备份</span></a></nav>",
      "css": ".ds-nav{display:flex;justify-content:center;gap:4px;font:400 14px/1.65 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;}.ds-nav a{display:flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;text-decoration:none;color:#686868;border-radius:999px;transition:background-color 160ms ease,color 160ms ease;}.ds-nav a:hover{background:#f3f3f1;color:#171717;}.ds-nav a.ds-nav-active{color:#fff;background:#171717;}.ds-nav a:focus-visible{outline:3px solid #767676;outline-offset:4px;}@media(max-width:640px){.ds-nav{width:100%;gap:3px;}.ds-nav a{flex:1;padding:8px 10px;font-size:12px;gap:6px;}}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none;}}"
    },
    {
      "name": "知识球体",
      "kind": "custom",
      "refersTo": "knowledge-orb",
      "description": "首页珍珠白球体只展出真实知识树；按领域轮播、悬停展开，空态为线框球，无加号和创建动作。",
      "html": "<div class=\"ds-orb\" role=\"img\" aria-label=\"知识球体\"><svg viewBox=\"0 0 440 440\" aria-hidden=\"true\"><defs><radialGradient id=\"ds-orb-surface\" cx=\"32%\" cy=\"22%\" r=\"85%\"><stop offset=\"0\" stop-color=\"#ffffff\"/><stop offset=\".55\" stop-color=\"#f1f1ee\"/><stop offset=\"1\" stop-color=\"#d9d9d3\"/></radialGradient></defs><circle cx=\"220\" cy=\"220\" r=\"194\" fill=\"url(#ds-orb-surface)\"/><g stroke=\"#171717\" fill=\"none\" opacity=\".14\"><ellipse cx=\"220\" cy=\"220\" rx=\"166\" ry=\"194\"/></g><path d=\"M139 273 208 133 299 250\" stroke=\"#8f8f8a\" fill=\"none\"/><circle cx=\"139\" cy=\"273\" r=\"6\" fill=\"#171717\"/><circle cx=\"208\" cy=\"133\" r=\"9\" fill=\"#456785\"/><circle cx=\"299\" cy=\"250\" r=\"6\" fill=\"#171717\"/></svg><span class=\"ds-orb-caption\">正在展出：我的领域</span></div>",
      "css": ".ds-orb{position:relative;display:block;width:min(100%,440px);aspect-ratio:1;border-radius:50%;background:transparent;color:#171717;}.ds-orb>svg{display:block;width:100%;height:100%;filter:drop-shadow(10px 18px 22px #00000015);}.ds-orb-caption{position:absolute;bottom:-6px;left:0;right:0;color:#686868;font-size:12px;text-align:center;}@media(max-width:640px){.ds-orb{width:min(100%,310px);}}"
    },
    {
      "name": "首页领域卡片",
      "kind": "card",
      "refersTo": "space-card",
      "description": "大幅领域树图；标题和总根使用领域名，领域进入本领域知识卡片，知识节点直接阅读。保留字体并在内部滚动，无底部编辑、删除或箭头。",
      "html": "<article class=\"ds-space-card\"><header><a href=\"#space/example/cards\">我的领域</a><span>2 个知识节点</span></header><div class=\"ds-tree-figure\"><svg viewBox=\"0 0 900 300\" width=\"900\" height=\"300\"><path d=\"M70 150H290M290 150V80H520M290 150V220H520\" stroke=\"#c9c9c5\" fill=\"none\"/><a href=\"#space/example/cards\"><circle cx=\"70\" cy=\"150\" r=\"9\" fill=\"#456785\"/><text x=\"84\" y=\"154\">我的领域</text></a><a href=\"#space/example/cards?node=first\"><circle cx=\"520\" cy=\"80\" r=\"6\" fill=\"#171717\"/><text x=\"534\" y=\"84\">第一个知识点</text></a><a href=\"#space/example/cards?node=second\"><circle cx=\"520\" cy=\"220\" r=\"6\" fill=\"#171717\"/><text x=\"534\" y=\"224\">第二个知识点</text></a></svg></div><p>点击节点阅读 · 滚动画布浏览</p></article>",
      "css": ".ds-space-card{padding:28px;background:#f6f6f4;border-radius:24px;color:#171717;font:400 15px/1.65 'Microsoft YaHei',system-ui,sans-serif;}.ds-space-card header{display:flex;justify-content:space-between;gap:16px;}.ds-space-card header a{font-size:22px;text-decoration:none;color:inherit;}.ds-space-card header span,.ds-space-card p{font-size:12px;color:#686868;}.ds-tree-figure{height:360px;overflow:auto;}.ds-tree-figure svg{display:block;width:100%;min-width:900px;height:auto;}.ds-tree-figure text{font-size:16px;fill:#404040;}.ds-tree-figure a{cursor:pointer;}@media(max-width:640px){.ds-space-card{padding:22px;border-radius:20px;}.ds-tree-figure{height:260px;}.ds-tree-figure svg{width:900px;}}"
    },
    {
      "name": "SpaceIconPicker",
      "kind": "custom",
      "refersTo": "space-icon-picker",
      "description": "新建和编辑领域的图标点选器：默认书本、12 个内联 SVG 与 10 个常用 emoji；SVG 继承领域颜色，旧符号保留原值。点选收起并返回焦点，Escape 先收起面板；表单记录按钮选择的未保存状态，面板随原生对话框内部滚动。尺寸与网格只属于本组件。",
      "html": "<fieldset class=\"ds-icon-picker\" style=\"--ds-icon-color:#456785\"><legend>图标（可选）</legend><div class=\"ds-icon-picker-control\"><span class=\"ds-icon-preview\" aria-hidden=\"true\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 4h12a4 4 0 0 1 4 4v13H8a4 4 0 0 1-4-4V4zM8 9h8M8 13h6\"/></svg></span><span class=\"ds-icon-current\" aria-live=\"polite\">书本</span><button type=\"button\" class=\"ds-icon-trigger\" aria-expanded=\"false\" aria-controls=\"ds-icon-panel\">选择图标</button></div></fieldset>",
      "css": ".ds-icon-picker{min-width:0;margin:0 0 24px;padding:0;border:0;background:var(--paper,#fff);color:var(--ink,#171717);font:400 15px/1.65 'PingFang SC','Microsoft YaHei',system-ui,sans-serif;}.ds-icon-picker>legend{padding:0;margin-bottom:9px;font-size:14px;}.ds-icon-picker-control{display:flex;align-items:center;gap:12px;}.ds-icon-preview{display:grid;place-items:center;width:52px;height:52px;flex-shrink:0;border:1px solid var(--line,#e7e7e7);border-radius:12px;color:var(--ds-icon-color,#456785);font-size:28px;}.ds-icon-current{flex:1;min-width:0;font-size:14px;}.ds-icon-trigger{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:9px 12px;border:1px solid #dcdcdc;border-radius:8px;background:var(--paper,#fff);color:var(--ink,#171717);font-family:inherit;font-size:13px;font-weight:500;line-height:1.4;cursor:pointer;white-space:nowrap;transition:background-color .15s,border-color .15s;}.ds-icon-trigger:hover{background:#f1f1ef;}.ds-icon-picker button:focus-visible{outline:3px solid #767676;outline-offset:4px;}@media(max-width:640px){.ds-icon-picker-control{gap:8px;}.ds-icon-preview{width:48px;height:48px;}}@media(prefers-reduced-motion:reduce){.ds-icon-picker button{transition:none;}}"
    },
    {
      "name": "图谱节点",
      "kind": "custom",
      "refersTo": "graph-node",
      "description": "稳定知识节点按钮；编辑图点击直接打开正文，阅读图点击显示知识点。领域名称用作展示根，不持久化或占用深度。",
      "html": "<button type=\"button\" class=\"ds-graph-node ds-graph-selected\" aria-pressed=\"true\" title=\"知识节点\"><span>知识节点</span></button>",
      "css": ".ds-graph-node{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:3px;width:208px;height:64px;min-height:64px;padding:10px 14px;border:1px solid #d6d6d6;border-radius:8px;background:var(--paper,#fff);color:var(--ink,#171717);font:500 13px/1.4 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;text-align:left;white-space:normal;cursor:pointer;box-shadow:0 3px 8px #00000004;transition:background-color .15s,border-color .15s;}.ds-graph-node:hover{border-color:#8b8b8b;background:#f1f1ef;}.ds-graph-node.ds-graph-selected{border-color:#171717;background:#171717;color:#fff;}.ds-graph-node:focus-visible{outline:3px solid #767676;outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-graph-node{transition:none;}}.ds-graph-node span{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere;line-height:1.4;flex-shrink:0;}"
    },
    {
      "name": "知识目录行",
      "kind": "nav",
      "refersTo": "directory-row",
      "description": "白色目录中可折叠节点行；浅灰选中、名称省略、三点菜单，所有节点可有子节点与正文。手机三点常显。",
      "html": "<div class=\"ds-directory-row ds-directory-selected\"><button class=\"ds-directory-toggle\" type=\"button\" aria-expanded=\"true\" aria-label=\"收起知识结构\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"><path d=\"m6 9 6 6 6-6\"/></svg></button><button class=\"ds-directory-name\" type=\"button\">知识结构</button><button class=\"ds-directory-more\" type=\"button\" aria-label=\"操作知识结构\" aria-expanded=\"false\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"5\" cy=\"12\" r=\"1.5\"/><circle cx=\"12\" cy=\"12\" r=\"1.5\"/><circle cx=\"19\" cy=\"12\" r=\"1.5\"/></svg></button></div>",
      "css": ".ds-directory-row{display:flex;align-items:center;min-height:46px;border-radius:6px;color:#171717;background:#fff;font:400 14px/1.6 'PingFang SC','Microsoft YaHei',system-ui,sans-serif;}.ds-directory-row:hover,.ds-directory-row:focus-within{background:#f6f6f4;}.ds-directory-selected{background:#efefed;}.ds-directory-row button{background:transparent;border:0;color:inherit;cursor:pointer;}.ds-directory-toggle{flex:0 0 24px;min-height:36px;padding:0;}.ds-directory-name{flex:1;min-width:0;min-height:44px;padding:9px 7px;text-align:left;font:inherit;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.ds-directory-more{min-width:32px;min-height:36px;opacity:0;border-radius:5px;}.ds-directory-row:is(:hover,:focus-within) .ds-directory-more{opacity:1;}.ds-directory-more:hover{background:#e9e9e6;color:#171717;}.ds-directory-row button:focus-visible{outline:3px solid #767676;outline-offset:4px;}@media(max-width:850px){.ds-directory-more{opacity:1;}}"
    },
    {
      "name": "Markdown 编辑与预览",
      "kind": "custom",
      "refersTo": "studio-surface",
      "description": "等宽、独立白色圆角双框，间距24px；目录/节点图与Markdown/预览保持同一配对布局，手机上下排布。",
      "html": "<div class=\"ds-writing\"><section><header class=\"ds-pane-heading\">Markdown</header><textarea class=\"ds-markdown-editor\" aria-label=\"实时编辑知识内容\"># 知识点\n\n从这里写下你的知识。</textarea></section><section><header class=\"ds-pane-heading\">预览</header><article class=\"ds-markdown-preview\"><h3>知识点</h3><p>从这里写下你的知识。</p></article></section></div>",
      "css": ".ds-writing{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;background:#fff;color:var(--ink,#171717);font:400 15px/1.65 'PingFang SC','Microsoft YaHei',system-ui,sans-serif;overflow:hidden;}.ds-writing>section{min-width:0;border:1px solid var(--line,#e7e7e7);border-radius:16px;overflow:hidden;}.ds-pane-heading{padding:17px 22px;border-bottom:1px solid var(--line,#e7e7e7);font-size:14px;font-weight:500;}.ds-markdown-editor{display:block;width:100%;box-sizing:border-box;min-height:260px;padding:26px;border:0;border-radius:0;background:#fff;color:#171717;font:400 14px/1.9 ui-monospace,'SFMono-Regular',Consolas,'Microsoft YaHei',monospace;resize:vertical;}.ds-markdown-editor:focus-visible{outline:2px solid #c9c9c9;outline-offset:-2px;}.ds-markdown-preview{padding:28px 32px 40px;line-height:1.9;overflow-wrap:anywhere;}.ds-markdown-preview h3{margin:0;font-size:22px;font-weight:500;}@media(max-width:850px){.ds-writing{grid-template-columns:minmax(0,1fr);}.ds-markdown-editor{padding:22px 18px;font-size:16px;}.ds-markdown-preview{padding:24px 22px;}}"
    }
  ],
  "narrative": {
    "northStar": "时习白色知识展台",
    "overview": "纯白底、墨色文字与浅灰展台组成安静而有辨识度的个人学习界面。首页在文字旁放置一颗珍珠白球体：球面轮播用户真实的知识树点线，缓慢自转，悬停时知识树展开成环绕轨道。学习领域以整行浅灰卡片陈列，卡片只承载该领域完整的点线树图（每个节点带名字）。知识库页把每棵知识树的根节点陈列成卡片，点进去看单树图谱。领域默认进入本领域知识卡片，首页图中的节点可直接阅读；目标界面已移除，旧目标数据仅通过备份保留。知识工作台保持两个等宽、独立白框，有两个状态：整理时左侧为可折叠目录、右侧为节点图；打开目录项后切换为左侧 Markdown 文本、右侧实时预览，返回后恢复目录。复习卡片与 FSRS 界面已于 2026-10 移除；旧卡片、图片与复习历史保留在本机与完整备份中。",
    "keyCharacteristics": [
      "纯白页面、珍珠球体、黑色主动作，中性灰承载层级；领域标记色只用于个人内容。",
      "品牌保留宋体特征，内容与操作以中文系统黑体保持清晰。",
      "桌面顶部居中三入口导航（学习空间 / 知识库 / 设置与备份），手机品牌与导航纵向居中排列。",
      "编辑与呈现成对出现；预览使用真实知识与当前草稿，保存状态显式可见。",
      "空态、计数与计划完成度均来自真实数据；球体只展出真实知识树，空账号为线框球。"
    ],
    "rules": [
      {
        "name": "The Structural Color Rule",
        "body": "彩色只来自用户数据：领域标记色出现在领域符号、进度与关联线上；界面本身的动作与状态保持黑白灰，选中同时通过描边、文字或可访问状态表达。",
        "section": "colors"
      },
      {
        "name": "The Readable Secondary Copy Rule",
        "body": "辅助文字降低视觉权重时保持可读；页脚、说明和计数沿用 `muted`，不要恢复更淡的次级文字颜色。",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "工作台以白纸与边界组织信息；沿用卡片纸面、目录菜单或模态的阴影时遵循其用途，不为每个列表层级增加浮层。",
        "section": "elevation"
      },
      {
        "name": "The Real Data Rule",
        "body": "球体展出、领域卡树图与编辑器图谱都来自用户的实际实体和关系；空态不补造节点或连线。",
        "section": "components"
      },
      {
        "name": "The Paired Editing Rule",
        "body": "Markdown 编辑与预览成对出现；实时预览不等于已经写入本机，工具栏明确显示保存与图片插入状态。",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** 沿用纯白、墨黑和可读灰色文字，让结构、球体与当前操作成为重点。",
      "**Do** 保留真实空态；以用户创建的领域、步骤和知识实体生成页面与计数。",
      "**Do** 让编辑与呈现成对出现，显式保存并明确未保存状态。",
      "**Do** 区分知识卡片阅读与知识目录编辑，保持节点直达内容。",
      "**Do** 保留展开、选中、当前页面、保存状态和可见键盘焦点的语义。",
      "**Do** 用内联 SVG 表达应用操作与品牌球体；将用户自选领域颜色与符号视为个人内容。"
    ],
    "donts": [
      "**Don't** 在初始学习空间预设学科、目标、知识节点或示例完成率。",
      "**Don't** 以任何形式恢复复习卡片界面替代知识树结构；旧复习数据只通过备份保留与导出。",
      "**Don't** 把完成步骤解释为已掌握知识，或用颜色单独表达关系与完成状态。",
      "**Don't** 引入深色主题、营销首屏、数据大屏或花哨后台来替换白色展台语言；也不要回到旧版绿色侧栏视觉。",
      "**Don't** 给每个工作台容器添加重阴影、全屏模糊或循环动画；球体自转是唯一持续动画，页面隐藏即暂停。",
      "**Don't** 把预览中的未保存草稿当作已持久化数据，或静默丢弃用户输入。",
      "**Don't** 让 Markdown 渲染原始 HTML；公式走 KaTeX，图片仅接受 IndexedDB 引用或 `http(s)` Markdown 图片地址。"
    ]
  }
}
